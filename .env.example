# Dashboard access. Basic authentication is mandatory when NODE_ENV=production.
# Serve production traffic through HTTPS; the Compose port binds to localhost by default.
AUTH_MODE=basic
DASHBOARD_USERNAME=pulseboard-operator
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# API runtime
API_HOST=0.0.0.0
API_PORT=3001
# Dashboard refresh interval in seconds (10-3600)
AUTO_REFRESH_SECONDS=30
# IANA timezone used by hourly, daily, and weekday scheduled jobs.
TZ=Asia/Kathmandu
SCHEDULED_JOB_TIME_ZONE=Asia/Kathmandu
# Optional engineering infrastructure inventory path, relative to the project root.
INFRASTRUCTURE_INVENTORY_PATH=config/infrastructure-servers.json
# Optional start/stop controls for infrastructure entries that have an instanceId.
EC2_CONTROL_ENABLED=false
EC2_CONTROL_URL=https://example.execute-api.us-east-1.amazonaws.com/prod/ec2-control
EC2_CONTROL_SIGNING_SECRET=replace-with-a-long-random-secret
# Your existing Slack user ID, used by the Lambda's current instance allowlists and StartedBy tag.
EC2_CONTROL_USER_ID=U01XXXXXXXX
EC2_CONTROL_TIMEOUT_MS=15000
# Disk alerts use percentage of free space on fixed volumes.
DISK_WARNING_PERCENT_FREE=20
DISK_CRITICAL_PERCENT_FREE=10
# Set true only behind a trusted proxy that sets X-Forwarded-Proto.
TRUST_PROXY=false

# Optional host bind for Docker Compose. Use 0.0.0.0 only behind a firewall/proxy.
PULSEBOARD_BIND_ADDRESS=127.0.0.1

# Shared Windows service account used for direct PowerShell remoting
SERVICE_USERNAME=DOMAIN\svc-testmachine
SERVICE_PASSWORD=replace-with-your-password

SERVICE_CHECKS_ENABLED=false

# Latest exception from each test machine's PCD SQL Server database.
# The SQL host defaults to that machine's inventory IP. Use a read-only SQL login.
SQL_ERROR_CHECKS_ENABLED=false
SQL_USERNAME=
SQL_PASSWORD=
SQL_PCD_DATABASE=PCD
SQL_PORT=1433
# Number of recent exceptions shown per machine (1-50; defaults to 5).
SQL_ERROR_LIMIT=5
# Optional shared hostname, or a per-machine hostname such as SQL_SERVER_DEV_QC03.
# Use a DNS hostname rather than an IP when SQL_ENCRYPT=true.
SQL_SERVER=
SQL_SERVER_DEV_QC01=
SQL_SERVER_DEV_QC02=
SQL_SERVER_DEV_QC03=
SQL_SERVER_DEV_QC04=
SQL_ENCRYPT=true
# Set true only when the SQL Server uses a certificate not trusted by the API host.
SQL_TRUST_SERVER_CERTIFICATE=false
# Optional column name containing the exception date/time when automatic detection is insufficient.
SQL_ERROR_TIME_COLUMN=

# TeamCity release branch used for pending-change checks and component build triggers
CURRENT_RELEASE=v11.8.5.0
CURRENT_RELEASE_PIPELINE=34919
CURRENT_RELEASE_ENVIRONMENT=QA

# GitLab pipeline status
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT_ID=group/project-or-numeric-id
GITLAB_TOKEN=replace-with-gitlab-pat
# Separate comma-separated numeric project IDs for Code Freeze approvals.
GITLAB_APPROVAL_PROJECT_IDS=177
# Optional personal token for approval actions (api scope); falls back to GITLAB_TOKEN.
# Actions are recorded as the token owner. Keep the dashboard private to that owner.
GITLAB_APPROVAL_TOKEN=
# Optional comma-separated exact GitLab target branches; empty checks all branches in the approval projects.
# GitLab approval rules determine what needs approval, including after code freeze.
GITLAB_APPROVAL_TARGET_BRANCH=
# Optional AI review of approval candidates. Set openai or groq; inferred when only one key is set.
AI_PROVIDER=
# Explicit opt-in: sends the newest PCD exception fields to the configured AI provider.
AI_ERROR_SUMMARIES_ENABLED=false
# Optional summary model override. Provider-specific values take precedence.
AI_ERROR_SUMMARY_MODEL=
OPENAI_ERROR_SUMMARY_MODEL=
GROQ_ERROR_SUMMARY_MODEL=
# Source diffs are sent to the selected provider with response storage disabled.
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.6-sol
GROQ_API_KEY=
GROQ_REVIEW_MODEL=openai/gpt-oss-120b

# TeamCity build status
TEAMCITY_URL=https://teamcity.example.com
TEAMCITY_TOKEN=replace-with-teamcity-token
# These defaults support deployment comparison plus branch-specific pending-change/build activity.
TEAMCITY_CONSOLE_BUILD_TYPE_ID=MainRepository_Venio_VenioFRPWixSetup_Default
TEAMCITY_ONDEMAND_BUILD_TYPE_ID=MainRepository_VenioWeb_VenioOnDemandAPI_Setup
TEAMCITY_WEB_BUILD_TYPE_ID=MainRepository_VenioWeb_VenioWebWixSetup_Default

# Dedicated TeamCity build configuration used for service query/start/stop
TEAMCITY_SERVICE_BUILD_TYPE_ID=Pulseboard_ServiceControl
# Maximum time the API waits for the dashboard status build (milliseconds)
TEAMCITY_SERVICE_STATUS_TIMEOUT_MS=180000
# Persistent deployment schedules; relative paths resolve from the project root.
# Docker Compose provides a named volume at /app/data.
DEPLOYMENT_SCHEDULE_PATH=data/deployment-schedules.json

# Local Python and PowerShell scheduled jobs.
# State includes inline script content; keep this file private and backed up.
SCHEDULED_JOBS_PATH=data/scheduled-jobs.json
# Maximum execution time per run, in milliseconds (1000-86400000).
SCHEDULED_JOB_TIMEOUT_MS=900000
# Optional interpreter overrides. Defaults: python.exe/powershell.exe on Windows,
# python3/pwsh on Linux and in the supplied container.
PYTHON_BIN=
POWERSHELL_BIN=

# Active Directory password expiry and resets (SIMPLE bind over LDAPS)
AD_SERVER=dc01.ad.veniosystems.com
AD_BASE_DN=DC=ad,DC=veniosystems,DC=com
AD_BIND_USER=
AD_BIND_PASSWORD=
AD_AUTH=SIMPLE
AD_USE_SSL=true
AD_PORT=636
# Trust your domain controller CA. Set false only for a self-signed test setup.
LDAP_VERIFY_CERT=true
# Optional PEM CA certificate path, accessible inside the API host/container.
LDAP_CA_CERT_FILE=
FORCE_CHANGE_AT_NEXT_LOGON=false
UNLOCK_ACCOUNT_AFTER_RESET=true
